# docker/Dockerfile.server

# ── Stage 1: Build ───────────────────────────────────────────────────────────
# Pinned, not floating: `rust:slim` would drift under the image and change what
# gets shipped without a commit. 1.98 is the toolchain that resolved Cargo.lock.
#
# The floor is 1.85 — evnx-crypto declares `rust-version = "1.85"` (zeroize_derive
# needs edition2024). This said 1.76 until 2026-09-13, which could not have built
# the crate at all; it went unnoticed because the missing sibling checkout for the
# old `path` dependency failed the build earlier still.
#
# ⚠️ The Debian release is pinned explicitly on BOTH stages and they must match.
# The binary links dynamically against glibc, so a builder newer than the runtime
# produces an image that builds cleanly and then dies on start with
# `libc.so.6: version 'GLIBC_2.38' not found`. Bare `rust:1.98-slim` is trixie
# while the runtime was bookworm — exactly that failure. Verified by running the
# binary, which a successful `docker build` does not do.
FROM rust:1.98-slim-trixie AS builder

WORKDIR /app
RUN apt-get update && apt-get install -y pkg-config libssl-dev && rm -rf /var/lib/apt/lists/*

# Cache dependencies: copy manifests first, build with stubs, then copy source
COPY Cargo.toml Cargo.lock ./
RUN mkdir src && echo "fn main() {}" > src/main.rs
RUN cargo build --release && rm -rf src

# Build real source
COPY . .

# Stamped HERE, below the dependency-cache layer above, deliberately. Set before
# that `cargo build --release`, the SHA would change the stub-build layer on
# every commit and force a full dependency rebuild into every image — trading a
# short build for a long one to carry seven characters.
#
# Empty default so a plain `docker build` still works; `build.rs` then falls
# through to "unknown" rather than inventing a value. It cannot fall back to git
# here in any case: `.dockerignore` excludes `.git/`.
ARG GIT_SHA=""
ENV EVNX_BUILD_SHA=$GIT_SHA

ENV SQLX_OFFLINE=true
RUN touch src/main.rs && cargo build --release

# ── Stage 2: Runtime ──────────────────────────────────────────────────────────
# Same Debian release as the builder above — see the glibc note there.
FROM debian:trixie-slim AS production

RUN apt-get update && apt-get install -y ca-certificates libssl3 curl && rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/target/release/evnx-server /usr/local/bin/evnx-server

RUN useradd -r -s /bin/false evnx
USER evnx

EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s \
  CMD curl -f http://localhost:8080/health || exit 1

CMD ["evnx-server"]