
# Synced from .env
RUST_LOG=YOUR_VALUE_HERE
SERVER_PORT=8000
JWT_SECRET=YOUR_KEY_HERE
RESEND_API_KEY=YOUR_KEY_HERE
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# Email delivery. `log` writes the verification link to the log instead of
# sending it — development only, refused when ENVIRONMENT is staging/production.
EMAIL_TRANSPORT=log
# Public URL of this API; the verification link is built from it.
PUBLIC_API_URL=http://localhost:8080

# Canonical URL of the web dashboard. Optional.
#
# When set, the verification email links here instead of at the API, so the
# token stops travelling to the API in a query string where it lands in access
# logs. Leave it unset and the email keeps linking at the API, exactly as
# before — both endpoints redeem through the same transactional path.
#
# NOT the same thing as FRONTEND_URL, which is the CORS allow-list and may hold
# several origins including localhost. Which origins may call the API and which
# URL belongs in an email are different questions.
PUBLIC_APP_URL=http://localhost:3000
EMAIL_FROM=YOUR_VALUE_HERE
# Browser origins allowed to call this API (CORS). Comma-separated.
# In development you typically want the local dashboard only.
FRONTEND_URL=http://localhost:3000
REFRESH_TOKEN_EXPIRY_DAYS=YOUR_KEY_HERE
ENVIRONMENT=YOUR_VALUE_HERE
# Valkey. Scheme stays redis:// — the `redis` crate is the client.
VALKEY_URL=redis://:evnx_valkey_dev@127.0.0.1:6379/0
JWT_EXPIRY_MINUTES=YOUR_VALUE_HERE
SERVER_HOST=localhost
MAX_REQUEST_SIZE_KB=YOUR_VALUE_HERE
DATABASE_MAX_CONNECTIONS=YOUR_VALUE_HERE

# ─── Master-password rotation ─────────────────────────────────────────────────
# How long a master-key rotation can be undone, in hours. 72 by default.
#
# The undo is authorised by proving the OLD password, which is the credential
# that separates a locked-out owner from whoever rotated their account. ⚠️ While
# the window is open, a rotation performed BECAUSE the old password leaked is
# reversible by whoever leaked it — that is why the request carries a reason, and
# why `compromised` stores no snapshot.
#
# `0` disables the undo entirely: no snapshot is kept and a locked-out account
# has no route back. An unparseable value fails startup rather than defaulting.
MASTER_KEY_UNDO_WINDOW_HOURS=72

# ─── Plan limits ──────────────────────────────────────────────────────────────
# QUOTA_<PLAN>_<WHAT>, where PLAN is FREE | TEAM | ENTERPRISE and WHAT is
# VAULTS | VERSIONS | TOKENS | AUDIT_DAYS. Every one is optional and falls back
# to the default shown. `unlimited` is spelled out; an unparseable value fails
# startup rather than silently becoming unlimited.
#
# ⚠️ Audit retention is a VISIBILITY limit, not deletion — `audit_events` is
# append-only by trigger since migration 006, so nothing prunes it and nothing
# can. Do not describe it as deletion anywhere.
QUOTA_FREE_VAULTS=3
QUOTA_FREE_VERSIONS=5
QUOTA_FREE_TOKENS=2
QUOTA_FREE_AUDIT_DAYS=7

# # .env.example — updated for Hetzner deployment

# # ─── Storage ───────────────────────────────────────────────────────────────────
# # Hetzner Object Storage:
# #   Region: fsn1 (Falkenstein), nbg1 (Nuremberg), hel1 (Helsinki)
# #   Endpoint: https://{region}.your-objectstorage.com
# #   IMPORTANT: DO NOT set force_path_style — Hetzner uses virtual-hosted style
# #   Bucket naming: lowercase letters, numbers, hyphens only (3-63 chars)
# # # # # 
# # LocalStack (local dev only — comment out for production):
# # # # # # # # # # AWS_SECRET_ACCESS_KEY=test
# ─── Object storage ───────────────────────────────────────────────────────────
# The backend is named explicitly and never inferred from an endpoint hostname.
#   s3    — AWS S3 or any S3-compatible service (Hetzner, MinIO, R2, Wasabi, B2)
#   gcs   — Google Cloud Storage   (GOOGLE_SERVICE_ACCOUNT / _KEY)
#   azure — Azure Blob Storage     (AZURE_STORAGE_ACCOUNT_NAME / _ACCESS_KEY)
#   local — filesystem; development only, refused outside ENVIRONMENT=development
STORAGE_BACKEND=s3
STORAGE_BUCKET=evnx-vaults
STORAGE_REGION=us-east-1

# S3-compatible providers only. Omit for AWS.
#   Hetzner:    https://fsn1.your-objectstorage.com   (STORAGE_PATH_STYLE=false)
#   MinIO:      http://localhost:9000                 (STORAGE_PATH_STYLE=true)
#   LocalStack: http://localhost:4566                 (STORAGE_PATH_STYLE=true)
# STORAGE_ENDPOINT=
STORAGE_PATH_STYLE=false

# Used by the `local` backend only.
# STORAGE_LOCAL_PATH=./data/blobs

# S3 credentials are optional: when absent, credentials are resolved from the
# environment or the instance role, which is how production should supply them.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
