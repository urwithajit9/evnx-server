# .env.prod.example — copy to .env.prod on the server and fill in.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod is gitignored. Never commit it: it holds the JWT signing key, the
# database password and the object-store credentials.

# ─── Identity ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# The base for emailed verification links. It must be the hostname users can
# actually reach, and it must match the certificate Caddy holds — a link that
# fails to load is an account nobody can verify.
PUBLIC_API_URL=https://api.evnx.dev
FRONTEND_URL=https://api.evnx.dev

# Caddy reads these two.
API_DOMAIN=api.evnx.dev
ACME_EMAIL=you@example.com

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
MAX_REQUEST_SIZE_KB=8192

# ─── Secrets — generate, do not invent ───────────────────────────────────────
# JWT_SECRET signs every access token. A guessable value means anyone can mint a
# session for any account. Generate it:
#     openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# openssl rand -hex 24
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=evnx
POSTGRES_USER=evnx
# Host is the compose service name; the database is not reachable from outside.
DATABASE_URL=postgresql://evnx:${POSTGRES_PASSWORD}@postgres:5432/evnx
DATABASE_MAX_CONNECTIONS=10

# ─── Valkey ──────────────────────────────────────────────────────────────────
# The scheme stays redis:// — that is what the `redis` Rust crate parses. There
# is no valkey:// scheme and using one fails at Client::open.
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0

# ─── Object storage — Cloudflare R2 ──────────────────────────────────────────
# STORAGE_BACKEND=local is refused outside development (config.rs), because the
# filesystem is not shared between instances. R2 is S3-compatible, so the `s3`
# backend drives it with an explicit endpoint.
STORAGE_BACKEND=s3
STORAGE_BUCKET=evnx-vaults
# https://<ACCOUNT_ID>.r2.cloudflarestorage.com — from the R2 dashboard
STORAGE_ENDPOINT=
# R2 ignores the region but the S3 client requires one. `auto` is what R2 documents.
STORAGE_REGION=auto
# R2 does not support virtual-hosted-style addressing.
STORAGE_PATH_STYLE=true
# From an R2 API token scoped to this bucket, Object Read & Write.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Email — Resend ──────────────────────────────────────────────────────────
# `log` is refused outside development: it prints a live verification token.
EMAIL_TRANSPORT=resend
EMAIL_FROM=noreply@evnx.dev
RESEND_API_KEY=
