# .env.prod.example — copy to .env.prod on the server and fill in.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# .env.prod is gitignored. Never commit it: it holds the JWT signing key, the
# database password and the object-store credentials.

# ─── Identity ────────────────────────────────────────────────────────────────
ENVIRONMENT=production
# The base for emailed verification links. It must be the hostname users can
# actually reach, and it must match the certificate Caddy holds — a link that
# fails to load is an account nobody can verify.
PUBLIC_API_URL=https://api.evnx.dev

# Canonical URL of the web dashboard. Optional.
#
# When set, the verification email links here instead of at the API, so the
# token stops travelling to the API in a query string where it lands in access
# logs. Leave it unset and the email keeps linking at the API, exactly as
# before — both endpoints redeem through the same transactional path.
#
# NOT the same thing as FRONTEND_URL, which is the CORS allow-list and may hold
# several origins including localhost. Which origins may call the API and which
# URL belongs in an email are different questions.
PUBLIC_APP_URL=https://app.evnx.dev
# Browser origins allowed to call this API (CORS). Comma-separated.
# This is the DASHBOARD's origin, not the API's — pointing it at api.evnx.dev
# blocks every request from app.evnx.dev, which is the default you want to change
# before the dashboard's first fetch.
# Refused at boot: `*` (unsafe with credentialed CORS) and non-localhost http
# outside development (bearer tokens travel on these requests).
FRONTEND_URL=https://app.evnx.dev

# Caddy reads these two.
API_DOMAIN=api.evnx.dev
ACME_EMAIL=you@example.com

# ─── Server ──────────────────────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
RUST_LOG=info
MAX_REQUEST_SIZE_KB=8192

# ─── Secrets — generate, do not invent ───────────────────────────────────────
# JWT_SECRET signs every access token. A guessable value means anyone can mint a
# session for any account. Generate it:
#     openssl rand -hex 48
JWT_SECRET=
JWT_EXPIRY_MINUTES=15
REFRESH_TOKEN_EXPIRY_DAYS=30

# openssl rand -hex 24
POSTGRES_PASSWORD=
VALKEY_PASSWORD=

# ─── Postgres ────────────────────────────────────────────────────────────────
POSTGRES_DB=evnx
POSTGRES_USER=evnx
# Host is the compose service name; the database is not reachable from outside.
DATABASE_URL=postgresql://evnx:${POSTGRES_PASSWORD}@postgres:5432/evnx
DATABASE_MAX_CONNECTIONS=10

# ─── Valkey ──────────────────────────────────────────────────────────────────
# The scheme stays redis:// — that is what the `redis` Rust crate parses. There
# is no valkey:// scheme and using one fails at Client::open.
VALKEY_URL=redis://:${VALKEY_PASSWORD}@valkey:6379/0

# ─── Object storage — Cloudflare R2 ──────────────────────────────────────────
# STORAGE_BACKEND=local is refused outside development (config.rs): a local
# filesystem is not shared between instances, so a multi-instance deployment
# would serve blobs that exist on only one node. Production needs a real S3 API.
#
# R2 is S3-compatible, so the `s3` backend drives it with an explicit endpoint.
# Blobs living off the box means a lost server costs no ciphertext, and the
# backup story covers only Postgres.
STORAGE_BACKEND=s3
STORAGE_BUCKET=evnx-vaults

# https://<ACCOUNT_ID>.r2.cloudflarestorage.com — shown in the R2 bucket settings.
# No bucket name in the path; the client appends it.
STORAGE_ENDPOINT=

# R2 ignores the region, but the S3 client requires one and `auto` is what R2
# documents. Anything else also works; this is the least surprising.
STORAGE_REGION=auto

# R2 supports only path-style addressing on its S3 endpoint
# (endpoint/bucket/key). Virtual-hosted style — bucket.endpoint/key — is not
# available, and leaving this false produces DNS failures that look like the
# bucket does not exist.
STORAGE_PATH_STYLE=true

# From the R2 API token: "Access Key ID" and "Secret Access Key".
# These are NOT a Cloudflare global API key, and not the token value itself.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── Alternative: self-hosted MinIO, for hosts that cannot use R2 ──
# Start the stack with `--profile minio` and set instead:
#   STORAGE_ENDPOINT=http://minio:9000   # plain http is fine: bridge network only
#   STORAGE_REGION=us-east-1
#   MINIO_ROOT_USER / MINIO_ROOT_PASSWORD, mirrored into AWS_ACCESS_KEY_ID /
#   AWS_SECRET_ACCESS_KEY — they are the same credentials.

# ─── Email — Resend ──────────────────────────────────────────────────────────
# `log` is refused outside development: it prints a live verification token.
EMAIL_TRANSPORT=resend
EMAIL_FROM=noreply@evnx.dev
RESEND_API_KEY=

# ─── Backups ────────────────────────────────────────────────────────────────
# Where to send an alert when the nightly backup fails. Reuses RESEND_API_KEY
# above, so it costs nothing extra. Leave it empty and failures are silent —
# which for backups is the same as having none, discovered far too late.
BACKUP_ALERT_EMAIL=

# Bucket for Postgres dumps. MUST be a different bucket from STORAGE_BUCKET:
# the dump contains every srp_verifier, which is password-equivalent for an
# offline dictionary attack. Ideally give it its own API token too, so a
# compromise of the server's storage key cannot also read or delete backups.
BACKUP_BUCKET=evnx-backups
