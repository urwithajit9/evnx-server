{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            u.id AS \"user_id!\",\n            u.email AS \"email!\",\n            m.role AS \"role!\",\n            m.granted_at AS \"granted_at!\",\n            m.granted_by,\n            (u.mlkem_public_key IS NOT NULL) AS \"has_mlkem_key!\"\n        FROM vault_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.vault_id = $1\n        ORDER BY (m.role = 'owner') DESC, m.granted_at ASC\n        ",
