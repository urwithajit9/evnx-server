{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT v.id, v.name, v.environment, v.created_at,\n               m.role, m.granted_at,\n               (v.owner_id = $1) AS \"is_owner!\"\n        FROM vaults v\n        JOIN vault_members m ON m.vault_id = v.id\n        WHERE m.user_id = $1 AND v.deleted_at IS NULL\n        ORDER BY v.name, v.environment\n        ",
