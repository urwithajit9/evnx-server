{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT m.vault_id, u.email, m.role, m.granted_at\n        FROM vault_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.vault_id = ANY($1)\n        ORDER BY m.vault_id, u.email\n        ",
