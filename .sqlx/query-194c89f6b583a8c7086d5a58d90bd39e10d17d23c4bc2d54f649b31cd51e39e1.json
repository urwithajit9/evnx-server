{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT u.id, u.email, m.role AS \"role!\",\n               m.seat_assigned_at, m.created_at AS \"joined_at!\"\n        FROM organization_members m\n        JOIN users u ON u.id = m.user_id\n        WHERE m.org_id = $1\n        ORDER BY m.role DESC, u.email\n        ",
