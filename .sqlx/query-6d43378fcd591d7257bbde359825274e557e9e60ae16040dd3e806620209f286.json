{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            a.id          AS \"id!\",\n            a.event_type  AS \"event_type!\",\n            a.user_id,\n            u.email       AS \"actor_email?\",\n            a.metadata,\n            a.created_at  AS \"created_at!\"\n        FROM audit_events a\n        LEFT JOIN users u ON u.id = a.user_id\n        WHERE a.vault_id = $1\n        ORDER BY a.created_at DESC\n        LIMIT $2\n        ",
